<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Releve.Game</AssemblyName>
    <RootNamespace>Releve.Game</RootNamespace>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Release'">Exe</OutputType>
    <!-- RID fixe : la bibliotheque native raylib est copiee a cote de l'exe, quel que soit le mode de build. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ApplicationIcon Condition="Exists('assets\icons\releve.ico')">assets\icons\releve.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Les assets sont copies a cote de l'exe : le jeu les cherche la, quel que soit le repertoire de travail. -->
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Releve.Engine\Releve.Engine.csproj" />
    <PackageReference Include="Raylib-cs" />
  </ItemGroup>

</Project>
